renders a recovery configuration unchanged:
  1: |
    apiVersion: postgresql.cnpg.io/v1
    kind: Cluster
    metadata:
      labels:
        app.kubernetes.io/instance: grafana
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: grafana
        app.kubernetes.io/version: 13.2.4
        application.giantswarm.io/team: atlas
        helm.sh/chart: grafana-0.0.0-snapshot
        observability.giantswarm.io/tenant: giantswarm
      name: grafana-postgresql
      namespace: monitoring
    spec:
      bootstrap:
        recovery:
          recoveryTarget:
            targetTime: 2026-01-01T12:00:00Z
          source: grafana-postgresql
      externalClusters:
        - name: grafana-postgresql
          plugin:
            name: barman-cloud.cloudnative-pg.io
            parameters:
              barmanObjectName: grafana-postgresql-objectstore-recovery
              serverName: grafana-postgresql
      imageName: gsoci.azurecr.io/giantswarm/postgresql-cnpg:18.6
      instances: 2
      plugins:
        - enabled: true
          isWALArchiver: true
          name: barman-cloud.cloudnative-pg.io
          parameters:
            barmanObjectName: grafana-postgresql-objectstore-backup
      postgresql:
        parameters:
          max_slot_wal_keep_size: 128MB
          max_wal_size: 512MB
          wal_keep_size: 128MB
      storage:
        size: 2Gi
  2: |
    apiVersion: barmancloud.cnpg.io/v1
    kind: ObjectStore
    metadata:
      labels:
        app.kubernetes.io/instance: grafana
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: grafana
        app.kubernetes.io/version: 13.2.4
        application.giantswarm.io/team: atlas
        helm.sh/chart: grafana-0.0.0-snapshot
        observability.giantswarm.io/tenant: giantswarm
      name: grafana-postgresql-objectstore-backup
      namespace: monitoring
    spec:
      configuration:
        destinationPath: s3://giantswarm-test-grafana-postgresql/
        s3Credentials:
          inheritFromIAMRole: true
        wal:
          compression: gzip
      retentionPolicy: 30d
  3: |
    apiVersion: barmancloud.cnpg.io/v1
    kind: ObjectStore
    metadata:
      labels:
        app.kubernetes.io/instance: grafana
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: grafana
        app.kubernetes.io/version: 13.2.4
        application.giantswarm.io/team: atlas
        helm.sh/chart: grafana-0.0.0-snapshot
        observability.giantswarm.io/tenant: giantswarm
      name: grafana-postgresql-objectstore-recovery
      namespace: monitoring
    spec:
      configuration:
        destinationPath: s3://giantswarm-test-grafana-postgresql-old/
        s3Credentials:
          inheritFromIAMRole: true
        wal:
          compression: gzip
  4: |
    apiVersion: postgresql.cnpg.io/v1
    kind: ScheduledBackup
    metadata:
      labels:
        app.kubernetes.io/instance: grafana
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: grafana
        app.kubernetes.io/version: 13.2.4
        application.giantswarm.io/team: atlas
        helm.sh/chart: grafana-0.0.0-snapshot
      name: grafana-postgresql-hourly-backup
      namespace: monitoring
    spec:
      backupOwnerReference: self
      cluster:
        name: grafana-postgresql
      method: plugin
      pluginConfiguration:
        name: barman-cloud.cloudnative-pg.io
      schedule: 0 0 * * * *
